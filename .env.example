# cp .env.example .env     (never commit .env; on macOS/Linux also: chmod 600 .env)

# OAuth client of type "Web application" from your own Google Cloud project (docs/google-cloud-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# alias:email pairs, comma-separated, e.g. work:you@company.com. The alias is what you tell the assistant to pick
# an account. Only needed for the very first start (the server refuses to boot without one account):
# scripts/setup.py asks for it, then clears this line. Add more accounts later with `python3 scripts/setup.py add-account`
# or by asking the assistant to call account_add; no file editing. A non-empty value here blocks account_add.
GOOGLE_ACCOUNTS=

# Google emails allowed to sign in to the MCP server as owner (usually the same accounts as above)
MCP_OWNER_EMAILS=

# Signs the local access token your clients send (token mode). scripts/setup.py generates it;
# by hand: openssl rand -base64 32. Changing it revokes every token and re-auth link.
MCP_JWT_KEY=

# ---- Optional: defaults live in compose.yaml ----
# GOOGLE_PROFILE=read-only        # read-only (default) | safe-writes | full-writes
# GOOGLE_TOOLSETS=gmail,drive,sheets,docs,calendar
# GOOGLE_WRITE_DENY=drive:upload

# Strongly recommended once writes are enabled: Gmail recipients, Calendar attendees and Drive
# grantees outside this list are refused, and "anyone with the link" shares are blocked.
# GOOGLE_OUTBOUND_ALLOWLIST=@your-company.com,you@gmail.com
